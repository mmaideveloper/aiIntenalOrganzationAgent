        <mxCell id="v47" value="RAG + ACL Detail — simplified logic" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1350" height="35" as="geometry" />
        </mxCell>
        <mxCell id="v48" value="Goal: the LLM receives only authorized context. ACL filtering happens before retrieval, not after the model answers." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1350" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v49" value="&lt;b&gt;1. User claims&lt;/b&gt;&lt;br/&gt;user id, app roles,&lt;br/&gt;group ids from Entra" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.3;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v50" value="&lt;b&gt;2. Build ACL filter&lt;/b&gt;&lt;br/&gt;acl_group_ids / acl_user_ids&lt;br/&gt;classification / sensitivity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.3;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="310" y="150" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v51" value="&lt;b&gt;3. Permission-aware query&lt;/b&gt;&lt;br/&gt;pre-filter first&lt;br/&gt;then vector / hybrid search" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.3;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v52" value="&lt;b&gt;4. Search stores&lt;/b&gt;&lt;br/&gt;Azure AI Search +&lt;br/&gt;PostgreSQL / pgvector" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=1.3;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="890" y="150" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v53" value="&lt;b&gt;5. Build model context&lt;/b&gt;&lt;br/&gt;allowed chunks only&lt;br/&gt;with source metadata" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.3;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1170" y="150" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v54" value="&lt;b&gt;6. LLM + verifier&lt;/b&gt;&lt;br/&gt;answer grounded in sources&lt;br/&gt;block unsupported claims" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.3;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1170" y="330" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e55" value="claims" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=1.8;fontSize=11;fontColor=#2563EB;endArrow=block;endFill=1;" edge="1" parent="1" source="v49" target="v50">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e56" value="OData / SQL filter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.8;fontSize=11;fontColor=#15803D;endArrow=block;endFill=1;" edge="1" parent="1" source="v50" target="v51">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e57" value="filtered retrieval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.8;fontSize=11;fontColor=#15803D;endArrow=block;endFill=1;" edge="1" parent="1" source="v51" target="v52">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e58" value="authorized chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.8;fontSize=11;fontColor=#15803D;endArrow=block;endFill=1;" edge="1" parent="1" source="v52" target="v53">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e59" value="prompt context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.8;fontSize=11;fontColor=#15803D;endArrow=block;endFill=1;" edge="1" parent="1" source="v53" target="v54">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v60" value="&lt;b&gt;Azure AI Search fields&lt;/b&gt;&lt;br/&gt;content, content_vector, document_id, chunk_id&lt;br/&gt;acl_group_ids: filterable only&lt;br/&gt;acl_user_ids: filterable only&lt;br/&gt;source_system, owner, sensitivity_label&lt;br/&gt;retrievable content: only what user can access" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#B45309;fontSize=11;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v61" value="&lt;b&gt;PostgreSQL / pgvector tables&lt;/b&gt;&lt;br/&gt;chunks(document_id, chunk_id, text_hash, metadata)&lt;br/&gt;embeddings(chunk_id, vector, model, version)&lt;br/&gt;feedback(user_id, answer_id, rating)&lt;br/&gt;audit_references(query_id, document_id, chunk_id)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#B45309;fontSize=11;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="360" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v62" value="&lt;b&gt;Design rule&lt;/b&gt;&lt;br/&gt;Access Packages decide who can use AI assistant functions.&lt;br/&gt;ACL metadata decides which document chunks the user can retrieve.&lt;br/&gt;The backend enforces both before calling the model." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#B45309;fontSize=11;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="590" width="930" height="105" as="geometry" />
        </mxCell>
        <mxCell id="v63" value="&lt;b&gt;Production caution&lt;/b&gt;&lt;br/&gt;Do not use a generic privileged service identity without user-context filtering. Do not send ACL metadata or denied document content to the LLM prompt." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#B45309;fontSize=11;fontColor=#111827;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="540" width="350" height="155" as="geometry" />
        </mxCell>
